# === LLM Provider Configuration ===
# Primary model (Party A agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Secondary model (Party B agent) — optional
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./fairdeal.db

# === Negotiation Defaults ===
MAX_ROUNDS=10
MAX_RETRIES=3

# === Server ===
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# === Cost Estimation (per 1M tokens) ===
OPENAI_INPUT_COST_PER_M=0.15
OPENAI_OUTPUT_COST_PER_M=0.60
GOOGLE_INPUT_COST_PER_M=0.075
GOOGLE_OUTPUT_COST_PER_M=0.30
