# ============================================
# FairStay — Environment Variables
# Copy to .env and fill in your API keys
# ============================================

# === LLM Provider (at least ONE key required) ===
# Groq (recommended — free tier, fast inference)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (optional)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./fairdeal.db

# === Negotiation Defaults ===
MAX_ROUNDS=10
MAX_RETRIES=3

# === Server ===
LOG_LEVEL=INFO
# For local dev: http://localhost:5173
# For production: * or your domain
CORS_ORIGINS=http://localhost:5173

# === Cost Estimation (per 1M tokens) ===
OPENAI_INPUT_COST_PER_M=0.15
OPENAI_OUTPUT_COST_PER_M=0.60
GOOGLE_INPUT_COST_PER_M=0.075
GOOGLE_OUTPUT_COST_PER_M=0.30
GROQ_INPUT_COST_PER_M=0.59
GROQ_OUTPUT_COST_PER_M=0.79
